############################################################
# 1. WHAT IS A COVARIATE?
############################################################

# A covariate is a measured variable that may influence
# gene expression but is not the main variable of interest.
#
# Examples:
# - Sex
# - Age
# - Smoking status
# - Depression status
# - Brain region
# - Sequencing batch
#
# In this analysis:
#
# Main variable of interest: _______________________________
#
# Covariates:
# 1. ______________________
# 2. ______________________
# 3. ______________________
#
# Our design will be:
#
# design = ~ sex + depression + smoking + alcohol_status
#


############################################################
# 2. CHECK THE METADATA
############################################################


table(meta_subset$sex)
table(meta_subset$depression)
table(meta_subset$smoking)
table(meta_subset$alcohol_status)

# Count the number of samples in each category* alcohol status




############################################################
# 4. CREATE THE DESEQ2 DATASET
############################################################

library(DESeq2)

dds_covar <- DESeqDataSetFromMatrix(
  countData = counts,
  colData = meta_subset,
  design = ~ sex + depression + smoking + alcohol_status
)

dds_covar

# The main variable of interest is placed last for convenience.
#
# For a simple additive model, changing the order of the
# variables does not change the fitted model.


############################################################
# 5. RUN DESEQ2
############################################################

dds_covar <- DESeq(dds_covar)


############################################################
# 6. VIEW THE AVAILABLE Comparisons
############################################################

resultsNames(dds_covar)



############################################################
# 7. EXTRACT THE AUD COMPARISON
############################################################

# Request the comparison explicitly:
#
# AUD Case versus non-AUD Control

res_covar <- results(
  dds_covar,
  contrast = c(
    "alcohol_status",
    " AUD_Case",
    " non_AUD_Control"
  ))

# Sort genes by adjusted p-value

res_covar <- res_covar[order(res_covar$padj), ]


#change to data frame

res_covar <-as.data.frame(res_covar)


############################################################
# 8. REMOVE ENSEMBL VERSION NUMBERS
############################################################

# Ensembl IDs may contain version numbers:
#
# ENSG00000123456.7
#
# BioMart usually expects:
#
# ENSG00000123456

rownames(res_covar) <- sub(
  "\\..*",
  "",
  rownames(res_covar)
)


############################################################
# 9. ADD GENE SYMBOLS BEFORE ASSESSING DE GENES
############################################################

library(biomaRt)

options(timeout = 900)

# Retrieve Ensembl gene IDs and HGNC gene symbols

annotation <- getBM(
  attributes = c(
    "ensembl_gene_id",
    "hgnc_symbol"
  ),
  filters = "ensembl_gene_id",
  values = rownames(res_covar),
  mart = mart
)

# Check the annotation table

dim(annotation)
head(annotation)

# Convert the DESeq2 results to a data frame

res_covar_df <- as.data.frame(res_covar)

# Preserve the Ensembl IDs as a regular column

res_covar_df$ensembl_gene_id <- rownames(res_covar_df)

# Merge DESeq2 results with gene annotation

res_covar_merged <- merge(
  res_covar_df,
  annotation,
  by = "ensembl_gene_id",
  all.x = TRUE
)

View(res_covar_merged)


