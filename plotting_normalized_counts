###let's extract the normalized counts
############################################################
# 16. EXTRACT NORMALIZED COUNTS
############################################################

# Raw counts are affected by sequencing depth.
#
# DESeq2 normalized counts are raw counts divided by the
# estimated size factor for each sample.
#
# Normalized counts correct for library-size differences.
#
# They are not covariate-adjusted counts.

norm_counts <- counts(
  dds_covar,
  normalized = TRUE
)

head(norm_counts)


############################################################
# 17. ADD GENE SYMBOLS TO NORMALIZED COUNTS
############################################################

