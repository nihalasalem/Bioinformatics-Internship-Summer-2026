#but first, we need to add the metadata to this table, 
#the easiest way is to transpose the normalized counts, so sample names can become names, and gene names can become columns
#do it your self now and type it in the chat
norm_counts_t<-t(norm_counts)
#merge the metadata_subset, use the row names (sample names) to merge
norm_counts_merged<-merge(meta_subset,norm_counts_t,by="row.names")

##this is a very big table but the metadata is at the end
#check
table(norm_counts_merged$alcohol_status)
##now you can use ggplot to plot the counts of specific gene
#try this one 	ENSG00000179813, it was significantly downregulated by alcohol
ggplot(norm_counts_merged,aes(x=alcohol_status,y=ENSG00000179813))+geom_point()
