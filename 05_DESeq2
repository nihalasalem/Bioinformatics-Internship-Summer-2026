############################################################
# 🧠 CONCEPT: WHAT IS A COVARIATE?
############################################################
# A covariate is a variable that may influence gene expression
# but is NOT the main variable of interest.
#
# Examples:
# - Sex
# - Age
# - Brain region
# - Batch
#
# If we want to control for them:
# design = ~ brain_region + sex + alcohol_status

# IN-CLASS QUESTION:
# Why would we want to control for brain region?


#add this to your code from previous class
#now include covariates
length(which(res$pvalue<0.05))
dds_covar <- DESeqDataSetFromMatrix(countData = counts,
                                    colData = meta_subset,
                                    design = ~ sex+depression+smoking+alcohol_status)
dds_covar
dds_covar <- DESeq(dds_covar)
resultsNames(dds_covar)
res_covar <- results(dds_covar,name="alcohol_status_.non_AUD_Control_vs_.AUD_Case")
length(which(res_covar$pvalue<0.05))
View(as.data.frame(res_covar))
rownames(res_covar)<-sub("\\..*", "", rownames(res_covar))
options(timeout = 900)   # 5 minutes
annotation <- getBM(attributes = c("ensembl_gene_id",
                                   "hgnc_symbol"),
                    filters = "ensembl_gene_id",
                    values = rownames(res_covar),
                    mart = mart)

# Check dimensions
dim(annotation)

#merge with res
res_covar_merged<-merge(as.data.frame(res_covar),annotation,by.x = "row.names",   # use rownames of counts
                        by.y = "ensembl_gene_id" )

#what do you realize about the number of differentialy expressed genes, compared to the model with no-covariates


#By default, DESeq2 uses the first level of the factor as the reference level.
#Log2 fold change is always:"(second level)vs(first level)"
meta_subset$alcohol_status
#AUD_Case  non_AUD_Control
#this means our fold change is control/AUD, so positive is higher in the control
#other way to check it
resultsNames(dds)
#"alcohol_status_.non_AUD_Control_vs_.AUD_Case"
#it is better to flip it , so that the control is the reference
#how to do that
#do this BEFORE you run deseq2
meta_subset$alcohol_status <- relevel(meta_subset$alcohol_status, ref = " non_AUD_Control")

##export a csv table with the genes with adjusted p-value less than 0.05
sig_dds_covar<-res_covar_merged[which(res_covar_merged$padj<0.05),]
write.csv(sig_dds_covar,file="deseq_AUD_covariates_significant_02272026.csv")
