library(readr)
#read the dataset
counts <- read.delim("/cloud/project/Summer_2026/Datasets/Human_AUD_GSE253155/counts.txt")
GSE253155_series_matrix <- read_csv("/cloud/project/Summer_2026/Datasets/Human_AUD_GSE253155/GSE253155_series_matrix.csv")
# Transpose the metadata
meta_raw<-GSE253155_series_matrix
meta_raw_t<-t(meta_raw)
colnames(meta_raw_t)<-meta_raw_t[1,]
meta_raw_t<-meta_raw_t[-1,]
#subset the meaningful columns
meta_subset<-meta_raw_t[,c(7,10,11,13,14)]
# 👉 Rename columns so they are meaningful
# (Age, Sex, Tissue, AUD_Status, Depression, etc.)
#rename the columns
colnames(meta_subset)<-c("brain_region","alcohol_status","sex","depression","smoking")
#Clean text fields
# Some entries look like:
# "Age; 45"
# We only want what comes AFTER the semicolon.
meta_subset<-sub(".*:", "", meta_subset)
meta_subset<-as.data.frame(meta_subset)
############################################################
# 🧬 PART 1 — CHECK SAMPLE MATCHING
############################################################



# Row names of metadata MUST match column names of count matrix

all(rownames(meta_subset) == colnames(counts))

length(intersect(rownames(meta_subset), colnames(counts)))

# View mismatches if needed
View(data.frame(
  metadata_samples = rownames(meta_subset),
  count_samples = colnames(counts)
))
 #QUESTION:
# Why is sample matching critical before running DESeq2?


############################################################
# 🧹 PART 2 — CLEAN SAMPLE NAMES
############################################################
##turns out the samples names are not matched, lets look at  why they are different

#gsub  is a very useful way of manipulating text

# Remove ".1" at the end of sample names
colnames(counts) <- gsub("\\.1$", "", colnames(counts))

# Remove "_merged" at the end of sample names
colnames(counts) <- gsub("_merged$", "", colnames(counts))

sample_names_dataframe<-data.frame(counts_names=colnames(counts),metadata_names=rownames(meta_subset))

#now check if the row names and colnames matches and in the same order
all(rownames(meta_subset) == colnames(counts))



############################################################
# 📦 PART 3 — INSTALL AND LOAD DESeq2
############################################################
#if (!require("BiocManager", quietly = TRUE))
#install.packages("BiocManager")

#BiocManager::install("DESeq2")
library(DESeq2)


############################################################
# 🧬 PART 4 — RUN DESEQ2 (ALL SAMPLES COMBINED)
############################################################

# Convert alcohol status to factor
#we did not discuss yet what a factor is
meta_subset$alcohol_status <- as.factor(meta_subset$alcohol_status)

# Design formula:
# ~ alcohol_status
# This means: compare Alcohol vs Control
dds <- DESeqDataSetFromMatrix(
  countData = counts,
  colData = meta_subset,
  design = ~ alcohol_status
)

dds

dds <- DESeq(dds)

res <- results(dds)

res_table<-as.data.frame(res)

# QUESTIONS:
# 1. What groups did we compare?
# 2. What might be the problem with combining PFC and NAc?


############################################################
# 🧬 PART 5 — ADD GENE SYMBOLS
############################################################
#what is ensemble id, gene names, gene symbols

BiocManager::install("biomaRt")
library(biomaRt)

# Connect to Ensembl
mart <- useMart("ensembl",
                dataset = "hsapiens_gene_ensembl")

# Remove version numbers from Ensembl IDs, wy?
rownames(res) <- sub("\\..*", "", rownames(res))

# Retrieve annotation
annotation <- getBM(
  attributes = c("ensembl_gene_id", "hgnc_symbol"),
  filters = "ensembl_gene_id",
  values = rownames(res),
  mart = mart
)

# Merge annotation with DESeq2 results
res_merged <- merge(
  as.data.frame(res),
  annotation,
  by.x = "row.names",
  by.y = "ensembl_gene_id"
)
#subset results_merged to keep only p-value<0.05


##extract the normalized count matrix, we will use it later
##what does normalized mean
norm_counts <- counts(dds, normalized = TRUE)
# Remove version numbers from Ensembl IDs, wy?
rownames(norm_counts ) <- sub("\\..*", "", rownames(norm_counts ))

#merge it with the gene names as we did before
# Retrieve annotation
annotation <- getBM(
  attributes = c("ensembl_gene_id", "hgnc_symbol"),
  filters = "ensembl_gene_id",
  values = rownames(norm_counts),
  mart = mart
)

# Merge annotation with DESeq2 results
norm_counts_merged <- merge(
  as.data.frame(norm_counts),
  annotation,
  by.x = "row.names",
  by.y = "ensembl_gene_id"
)
#save it
write.csv(norm_counts_merged,"AUD_normalized_counts.csv")

############################################################
